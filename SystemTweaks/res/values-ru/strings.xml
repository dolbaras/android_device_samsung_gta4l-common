<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">System Tweaks</string>
    <string name="intro">Настройки графики применяются сразу и сохраняются после перезагрузки и сброса. По умолчанию — родное разрешение.</string>

    <string name="render_title">Разрешение экрана (рендер)</string>
    <string name="render_900">900p (900×1500)</string>
    <string name="render_1080">1080p (1080×1800)</string>
    <string name="render_1200">1200p — родное (1200×2000)</string>

    <string name="rec_title">Разрешение записи экрана</string>
    <string name="rec_900">900p (до 1500)</string>
    <string name="rec_1080">1080p (до 1800)</string>
    <string name="rec_1200">1200p — родное (до 2000, может тормозить)</string>
    <string name="rec_note">Запись выше ~2 Мп (1200p) не тянет аппаратный кодек и может тормозить. 1080p — оптимум.</string>

    <string name="toast_render">Рендер: %1$dp</string>
    <string name="toast_rec">Запись экрана: %1$dp</string>
    <string name="err_render">Не удалось применить разрешение рендера</string>
    <string name="err_perm">Нет прав WRITE_SECURE_SETTINGS</string>
</resources>
